---
import BaseLayout from './BaseLayout.astro';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props { title: string; description?: string; ogImage?: string; canonicalURL?: string; }
const { title, description, ogImage, canonicalURL } = Astro.props;
const initials = profile.name.split(' ').filter(Boolean).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
const isResumePage = Astro.url.pathname.startsWith('/resume');
const currentPath = Astro.url.pathname;
---
<BaseLayout title={title} description={description} ogImage={ogImage} canonicalURL={canonicalURL}>
  <header class="site-header" role="banner">
    <div class="container container-wide">
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class="nav-brand" aria-label={`${profile.name} home`}>
          <span class="nav-mark" aria-hidden="true">{initials}</span>
          <span>
            <strong>{profile.name}</strong>
            <small>Systems / software</small>
          </span>
        </a>
        <div class="nav-controls">
          <ul class="nav-links">
            <li><a href="/#about" aria-current={currentPath === '/' || currentPath === '' ? 'page' : undefined}>About</a></li>
            <li><a href="/#projects">Work</a></li>
            <li><a href="/#experience">Experience</a></li>
            <li><a href="/resume/" aria-current={isResumePage ? 'page' : undefined}>Resume</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
          <button class="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true">◐</span>
            <span class="theme-toggle-label">Dark</span>
          </button>
        </div>
      </nav>
    </div>
  </header>
  <main id="main-content"><slot /></main>
  <footer class="site-footer">
    <div class="container container-wide">
      <p><span>System status</span> Available for selected opportunities.</p>
      <p>&copy; {new Date().getFullYear()} {profile.name}. Built with Astro.</p>
      <a href="#main-content">Return to top ↑</a>
    </div>
  </footer>
  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-bg) 94%, transparent);
      backdrop-filter: blur(10px);
    }
    .nav {
      display: flex;
      align-items: stretch;
      justify-content: space-between;
      min-height: 4.5rem;
      gap: var(--space-6);
    }
    .nav-brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      color: var(--color-text);
      text-decoration: none;
    }
    .nav-mark {
      display: grid;
      width: 2rem;
      height: 2rem;
      place-items: center;
      background: var(--color-accent);
      color: var(--accent-foreground);
      font-family: var(--font-family-mono);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      border-radius: var(--radius-sm);
    }
    .nav-brand strong, .nav-brand small { display: block; }
    .nav-brand strong { font-size: var(--font-size-sm); }
    .nav-brand small {
      margin-top: .12rem;
      color: var(--color-text-subtle);
      font-family: var(--font-family-mono);
      font-size: .65rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .nav-controls {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }
    .nav-links {
      display: flex;
      align-items: stretch;
      gap: var(--space-6);
      list-style: none;
    }
    .nav-links a {
      display: grid;
      place-items: center;
      min-height: 100%;
      padding: 0 var(--space-1);
      border-bottom: 2px solid transparent;
      color: var(--color-text-muted);
      font-family: var(--font-family-mono);
      font-size: var(--font-size-sm);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      transition: color var(--transition-fast), border-color var(--transition-fast);
    }
    .nav-links a:hover,
    .nav-links a[aria-current='page'] {
      border-color: var(--color-accent);
      color: var(--color-text);
    }
    .nav-links a:focus-visible {
      outline: none;
      box-shadow: var(--focus-ring);
      border-radius: var(--radius-sm);
    }
    .theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 2.5rem;
      padding: 0 var(--space-3);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font-family-mono);
      font-size: var(--font-size-xs);
      cursor: pointer;
      border-radius: var(--radius-md);
      transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
    }
    .theme-toggle:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
    .theme-toggle:focus-visible {
      outline: none;
      box-shadow: var(--focus-ring);
    }
    .theme-toggle-label {
      display: none;
    }
    @media (min-width: 721px) {
      .theme-toggle-label {
        display: inline;
      }
    }
    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: var(--space-6) 0;
      background: var(--color-primary);
      color: var(--color-primary-foreground);
    }
    .site-footer .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }
    .site-footer p { margin: 0; font-family: var(--font-family-mono); font-size: var(--font-size-xs); }
    .site-footer p span { margin-right: var(--space-2); color: var(--color-accent); text-transform: uppercase; }
    .site-footer a {
      font-family: var(--font-family-mono);
      font-size: var(--font-size-xs);
      color: var(--color-primary-foreground);
      text-decoration: underline;
      text-decoration-color: var(--color-border);
      transition: text-decoration-color var(--transition-fast);
    }
    .site-footer a:hover {
      text-decoration-color: var(--color-accent);
    }
    @media (max-width: 720px) {
      .nav {
        display: block;
        padding: var(--space-3) 0 0;
      }
      .nav-controls {
        display: block;
      }
      .nav-links {
        width: calc(100% + var(--space-8));
        margin-left: calc(-1 * var(--space-4));
        padding: var(--space-3) var(--space-4);
        overflow-x: auto;
        gap: var(--space-6);
        white-space: nowrap;
      }
      .nav-links a {
        min-height: 2.5rem;
        padding: 0 var(--space-2);
      }
      .theme-toggle {
        position: absolute;
        top: var(--space-4);
        right: var(--space-4);
        min-height: 2.25rem;
        padding: 0 var(--space-2);
      }
      .theme-toggle-label {
        display: none;
      }
      .site-footer .container {
        display: grid;
        gap: var(--space-3);
        text-align: center;
      }
    }
  </style>
  <script is:inline>
    (() => {
      const toggle = document.querySelector('.theme-toggle');
      if (!toggle) return;
      const root = document.documentElement;
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      const VALID_THEMES = ['light', 'dark'];
      const getTheme = () => {
        const theme = root.dataset.theme;
        return VALID_THEMES.includes(theme) ? theme : (media.matches ? 'dark' : 'light');
      };
      const update = () => {
        const dark = getTheme() === 'dark';
        toggle.setAttribute('aria-pressed', String(dark));
        toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
        const label = toggle.querySelector('.theme-toggle-label');
        const icon = toggle.querySelector('.theme-toggle-icon');
        if (label) label.textContent = dark ? 'Light' : 'Dark';
        if (icon) icon.textContent = dark ? '☀' : '◐';
      };
      toggle.addEventListener('click', () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('portfolio-theme', nextTheme);
        update();
      });
      media.addEventListener('change', () => {
        if (!localStorage.getItem('portfolio-theme')) update();
      });
      update();
    })();
  </script>
</BaseLayout>