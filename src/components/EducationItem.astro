---
import { formatDate } from '../utils/format';

interface Props {
  education: any;
}

const { education } = Astro.props;
const { data } = education;
---

<article class="education-item">
  <h3>{data.degree} in {data.field}</h3>
  <p class="education-meta">
    {data.institution}
    {data.location && <span> · {data.location}</span>}
    <span> · {formatDate(data.startDate)} – {data.endDate ? formatDate(data.endDate) : 'Present'}</span>
  </p>
  {data.description && <p class="education-desc">{data.description}</p>}
  {data.honors && data.honors.length > 0 && (
    <ul class="honors-list">
      {data.honors.map((honor: string) => <li>{honor}</li>)}
    </ul>
  )}
</article>

<style>
  .education-item {
    margin-bottom: var(--space-6);
  }

  .education-item:last-child {
    margin-bottom: 0;
  }

  .education-item h3 {
    font-size: var(--font-size-base);
    margin-bottom: var(--space-1);
    line-height: var(--line-height-snug);
  }

  .education-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
    margin: 0 0 var(--space-2);
    line-height: var(--line-height-relaxed);
  }

  .education-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2);
    line-height: var(--line-height-relaxed);
  }

  .honors-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .honors-list li {
    font-size: var(--font-size-sm);
    padding: var(--space-1) var(--space-2);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
  }
  .honors-list li:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg);
  }
</style>