---
import { formatDate } from '../utils/format';
import type { CollectionEntry } from 'astro:content';

interface Props {
  education: CollectionEntry<'education'>;
}

const { education } = Astro.props;
const { data } = education;
---
<article class="education-item grid-safe">
  <h3 class="education-item__title">{data.degree} in {data.field}</h3>
  <p class="education-item__meta">
    {data.institution}
    {data.location && <span> · {data.location}</span>}
    <span> · {formatDate(data.startDate)} – {data.endDate ? formatDate(data.endDate) : 'Present'}</span>
  </p>
  {data.description && <p class="education-item__desc">{data.description}</p>}
  {data.honors && data.honors.length > 0 && (
    <ul class="education-item__honors">
      {data.honors.map((honor: string) => <li>{honor}</li>)}
    </ul>
  )}
</article>