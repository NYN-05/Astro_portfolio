---
import { formatDate } from '../utils/format';
import type { CollectionEntry } from 'astro:content';

interface Props {
  achievements: CollectionEntry<'achievements'>[];
}

const { achievements } = Astro.props;

const ICONS: Record<string, string> = {
  award: '🏆',
  hackathon: '🏆',
  certification: '✓',
  other: '•',
  publication: '↗',
};

const typeClassMap: Record<string, string> = {
  award: 'recognition-item--award',
  hackathon: 'recognition-item--award',
  certification: 'recognition-item--certification',
  publication: 'recognition-item--publication',
  other: 'recognition-item--other',
};
---
<ol class="recognition-list">
  {achievements.map((achievement, index) => (
    <li class:list={['recognition-item', typeClassMap[achievement.data.type] || 'recognition-item--other', index === 0 && 'recognition-item--featured']}>
      <div class="recognition-mark" aria-hidden="true">
        <span class="recognition-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="recognition-icon">{ICONS[achievement.data.type] ?? '•'}</span>
      </div>
      <div class="recognition-body">
        <h3 class="recognition-title">{achievement.data.title}</h3>
        {achievement.data.issuer && <p class="recognition-org">{achievement.data.issuer}</p>}
        {achievement.data.description && (
          <p class="recognition-desc">{achievement.data.description}</p>
        )}
        <div class="recognition-foot">
          <time class="recognition-date" datetime={achievement.data.date}>{formatDate(achievement.data.date, 'long')}</time>
          {achievement.data.url && (
            <a
              href={achievement.data.url}
              class="recognition-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              View details
            </a>
          )}
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .recognition-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recognition-item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .recognition-item--featured {
    padding: var(--space-8) 0 var(--space-6);
    border-top: 1px solid var(--color-accent);
  }

  .recognition-mark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    padding-top: 0.15rem;
  }

  .recognition-number {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.05em;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  .recognition-item:hover .recognition-number {
    color: var(--color-accent);
  }

  .recognition-icon {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-lg);
    line-height: 1;
    color: var(--color-accent);
  }

  .recognition-item--featured .recognition-number {
    font-size: var(--font-size-sm);
  }

  .recognition-item--featured .recognition-icon {
    font-size: var(--font-size-xl);
  }

  .recognition-body {
    min-width: 0;
  }

  .recognition-title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    line-height: var(--line-height-snug);
    overflow-wrap: break-word;
  }

  .recognition-item--featured .recognition-title {
    max-width: 24ch;
    margin-bottom: var(--space-2);
    font-size: clamp(var(--font-size-2xl), 3vw, var(--font-size-4xl));
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    line-height: var(--line-height-tight);
    text-wrap: balance;
  }

  .recognition-org {
    margin: 0 0 var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .recognition-desc {
    max-width: 62ch;
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--color-text-secondary);
  }

  .recognition-item--featured .recognition-desc {
    max-width: 56ch;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .recognition-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .recognition-date {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
  }

  .recognition-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .recognition-link::after {
    content: '↗';
    margin-left: var(--space-2);
    transition: transform var(--transition-fast);
  }

  .recognition-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .recognition-link:hover::after {
    transform: translate(2px, -2px);
  }

  @media (max-width: 960px) {
    .recognition-item {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-4) 0;
    }

    .recognition-item--featured {
      padding: var(--space-6) 0 var(--space-4);
    }

    .recognition-item--featured .recognition-title {
      font-size: clamp(var(--font-size-xl), 4vw, var(--font-size-3xl));
    }
  }

  @media (max-width: 640px) {
    .recognition-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-4) 0;
    }

    .recognition-item--featured {
      padding: var(--space-5) 0;
    }

    .recognition-mark {
      flex-direction: row;
      align-items: center;
      gap: var(--space-2);
      padding-top: 0;
    }

    .recognition-item--featured .recognition-icon {
      font-size: var(--font-size-lg);
    }

    .recognition-item--featured .recognition-title {
      max-width: none;
      font-size: clamp(var(--font-size-lg), 6vw, var(--font-size-2xl));
    }

    .recognition-link {
      min-height: 2.5rem;
    }
  }
</style>