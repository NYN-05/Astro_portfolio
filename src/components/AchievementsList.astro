---
import { formatDate } from '../utils/format';

interface Props {
  achievements: any[];
}

const { achievements } = Astro.props;

const ICONS: Record<string, string> = {
  award: '🏆',
  hackathon: '🏆',
  certification: '✓',
  other: '{ }',
  publication: '↗',
};

const typeClassMap: Record<string, string> = {
  award: 'recognition-item--award',
  hackathon: 'recognition-item--award',
  certification: 'recognition-item--certification',
  publication: 'recognition-item--publication',
  other: 'recognition-item--other',
};
---
<ol class="recognition-list">
  {achievements.map((achievement, index) => (
    <li class:list={['recognition-item', typeClassMap[achievement.data.type] || 'recognition-item--other', index === 0 && 'recognition-item--featured']}>
      <div class="recognition-mark" aria-hidden="true">
        <span class="recognition-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="recognition-icon">{ICONS[achievement.data.type] ?? '🏆'}</span>
      </div>
      <div class="recognition-body">
        <h3 class="recognition-title">{achievement.data.title}</h3>
        {achievement.data.issuer && <p class="recognition-org">{achievement.data.issuer}</p>}
        {achievement.data.description && (
          <p class="recognition-desc">{achievement.data.description}</p>
        )}
        <div class="recognition-foot">
          <p class="recognition-meta">
            <span class="recognition-category">{achievement.data.type}</span>
            <span aria-hidden="true">·</span>
            <time datetime={achievement.data.date}>{formatDate(achievement.data.date, 'long')}</time>
          </p>
          {achievement.data.url && (
            <a
              href={achievement.data.url}
              class="recognition-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              View details
            </a>
          )}
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .recognition-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recognition-item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .recognition-item--featured {
    padding: var(--space-10) 0 var(--space-8);
    border-top: 2px solid var(--color-accent);
  }

  .recognition-mark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: 0.3rem;
  }

  .recognition-number {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  .recognition-item:hover .recognition-number {
    color: var(--color-accent);
  }

  .recognition-icon {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-lg);
    line-height: 1;
    color: var(--color-accent);
  }

  .recognition-item--featured .recognition-number {
    font-size: var(--font-size-sm);
  }

  .recognition-item--featured .recognition-icon {
    font-size: var(--font-size-2xl);
  }

  .recognition-body {
    min-width: 0;
  }

  .recognition-title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.02em;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  .recognition-item--featured .recognition-title {
    max-width: 24ch;
    margin-bottom: var(--space-3);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .recognition-org {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .recognition-desc {
    max-width: 62ch;
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-base);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .recognition-item--featured .recognition-desc {
    max-width: 56ch;
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .recognition-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .recognition-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .recognition-category {
    color: var(--color-text-muted);
  }

  .recognition-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .recognition-link::after {
    content: '↗';
    margin-left: var(--space-2);
    transition: transform var(--transition-fast);
  }

  .recognition-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .recognition-link:hover::after {
    transform: translate(2px, -2px);
  }

  @media (max-width: 960px) {
    .recognition-item {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-5) 0;
    }

    .recognition-item--featured {
      padding: var(--space-8) 0 var(--space-6);
    }

    .recognition-item--featured .recognition-title {
      font-size: clamp(1.6rem, 4.5vw, 2.25rem);
    }
  }

  @media (max-width: 640px) {
    .recognition-item {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }

    .recognition-item--featured {
      padding: var(--space-6) 0;
    }

    .recognition-mark {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
      padding-top: 0;
    }

    .recognition-item--featured .recognition-icon {
      font-size: var(--font-size-lg);
    }

    .recognition-item--featured .recognition-title {
      max-width: none;
      font-size: clamp(1.5rem, 7vw, 2rem);
    }

    .recognition-link {
      min-height: 2.75rem;
    }
  }
</style>