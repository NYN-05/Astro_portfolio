---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const { skills } = Astro.props;
---

<div class="skills-grid">
  {skills.map((skillGroup, index) => (
    <article class="skill-card">
      <p class="skill-card__label">
        <span class="skill-card__mark" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        Capability
      </p>
      <h3 class="skill-card__title">{skillGroup.data.category}</h3>
      {skillGroup.data.summary && <p class="skill-card__summary">{skillGroup.data.summary}</p>}
      <h4 class="skill-card__sub">Technologies</h4>
      <ul class="skill-card__tech">
        {skillGroup.data.items.map((item) => <li>{item}</li>)}
      </ul>
      {skillGroup.data.evidence && (
        <p class="skill-card__evidence">
          <span class="skill-card__sub">Applied</span>
          {skillGroup.data.evidence}
        </p>
      )}
    </article>
  ))}
</div>