---
/* eslint-disable jsx-a11y-x/no-noninteractive-tabindex -- The skill items are
   deliberately focusable so keyboard users get the same highlight feedback as
   pointer hover (requested focus state); they are intentional focus targets,
   not inert decorations. */
import type { CollectionEntry } from 'astro:content';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const { skills } = Astro.props;
---
<div class="skills-index">
  {skills.map((skillGroup, index) => (
    <article class="skill-row">
      <header class="skill-row__head">
        <span class="skill-row__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3 class="skill-row__title">{skillGroup.data.category}</h3>
      </header>
      <div class="skill-row__body">
        {skillGroup.data.summary && <p class="skill-row__desc">{skillGroup.data.summary}</p>}
        <ul class="skill-row__list">
          {skillGroup.data.items.map((item) => <li tabindex="0">{item}</li>)}
        </ul>
      </div>
    </article>
  ))}
</div>
