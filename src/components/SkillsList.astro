---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const { skills } = Astro.props;
---
<div class="skills-grid">
  {skills.map((skillGroup, index) => (
    <article class="skill-card grid-safe">
      <header class="skill-card__header">
        <span class="skill-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3 class="skill-card__title">{skillGroup.data.category}</h3>
      </header>
      {skillGroup.data.summary && <p class="skill-card__summary">{skillGroup.data.summary}</p>}
      <div class="skill-card__tech" aria-label="Technologies">
        {skillGroup.data.items.map((item) => <span class="tech-tag">{item}</span>)}
      </div>
      {skillGroup.data.evidence && (
        <p class="skill-card__evidence">
          <span class="skill-card__evidence-prefix" aria-hidden="true">Applied: </span>
          {skillGroup.data.evidence}
        </p>
      )}
    </article>
  ))}
</div>