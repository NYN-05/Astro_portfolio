---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skills: CollectionEntry<'skills'>[];
}

const { skills } = Astro.props;

const categoryClassMap: Record<string, string> = {
  'AI & Information Retrieval': 'skill-card--ai',
  'AI/ML & Computer Vision': 'skill-card--ml',
  'Programming Languages': 'skill-card--lang',
  'Software Engineering & Backend': 'skill-card--eng',
  'Tools & Scientific Computing': 'skill-card--tools',
};
---
<div class="skills-grid">
  {skills.map((skillGroup, index) => (
    <article class={`skill-card grid-safe ${categoryClassMap[skillGroup.data.category] || ''}`}>
      <p class="skill-card__label">
        <span class="skill-card__mark" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        Capability
      </p>
      <h3 class="skill-card__title text-wrap-anywhere">{skillGroup.data.category}</h3>
      {skillGroup.data.summary && <p class="skill-card__summary text-wrap-anywhere">{skillGroup.data.summary}</p>}
      <h4 class="skill-card__sub">Technologies</h4>
      <ul class="skill-card__tech">
        {skillGroup.data.items.map((item) => <li class="text-truncate">{item}</li>)}
      </ul>
      {skillGroup.data.evidence && (
        <p class="skill-card__evidence text-wrap-anywhere">
          <span class="skill-card__sub">Applied</span>
          {skillGroup.data.evidence}
        </p>
      )}
    </article>
  ))}
</div>