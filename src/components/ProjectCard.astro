---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'diagram' | 'metrics' | 'preview' | 'featured' | 'secondary';
}

const { project, variant } = Astro.props;
const { data } = project;
const isFeatured = variant === 'featured' || data.featured;
const year = data.startDate?.slice(0, 4) ?? '—';
const projectId = `project-${data.title.replace(/\s+/g, '-')}`;

let cardVariant: 'diagram' | 'metrics' | 'preview' | 'featured' | 'secondary' = 'secondary';
if (variant) {
  cardVariant = variant;
} else if (isFeatured) {
  cardVariant = 'featured';
}

const imageSrc = data.image;
const isLocalAsset = imageSrc && imageSrc.startsWith('./');
let imageMetadata: ImageMetadata | null = null;

if (isLocalAsset) {
  const imagePath = imageSrc.replace('./', '');
  if (imagePath === 'deepfake-kyc.png') {
    const deepfakeImage = await import('../content/projects/images/deepfake-kyc.png');
    imageMetadata = deepfakeImage.default;
  }
}

const normalizedImageSrc = imageSrc?.startsWith('./') ? imageSrc.replace('./', '/images/') : imageSrc;
const imageSizes = data.imageSizes || '(max-width: 720px) 100vw, 50vw';
---
<article class={`project-card project-card--${cardVariant}`} aria-labelledby={projectId}>
  {normalizedImageSrc && (
    <div class="project-card__image aspect-photo" aria-hidden="true">
      {isLocalAsset && imageMetadata ? (
        <Image
          src={imageMetadata}
          alt={data.imageAlt || data.title}
          loading="lazy"
          widths={[400, 800, 1200]}
          format="webp"
          quality={80}
          sizes={imageSizes}
        />
      ) : data.imageSrcset ? (
        <img
          src={normalizedImageSrc}
          srcset={data.imageSrcset}
          sizes={imageSizes}
          alt={data.imageAlt || data.title}
          loading="lazy"
          class="img-cover"
          onerror="this.style.display='none'; this.nextElementSibling?.style.display='flex';"
        />
      ) : (
        <img
          src={normalizedImageSrc}
          alt={data.imageAlt || data.title}
          loading="lazy"
          class="img-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      )}
      <div class="project-card__image-fallback" style="display:none; width:100%; height:100%; align-items:center; justify-content:center; background:var(--color-bg-subtle); color:var(--color-text-muted); font-family:var(--font-family-mono); font-size:var(--font-size-xs);">
        No preview available
      </div>
    </div>
  )}
  <div class="project-card__content grid-safe">
    <header class="project-card__header">
      <h3 id={projectId} class="project-card__title">{data.title}</h3>
      <time class="project-card__year" datetime={data.startDate ?? ''}>{year}</time>
    </header>
    <p class="project-card__description">{data.problem || data.description}</p>
    <div class="project-card__tech" aria-label="Technologies">
      {data.technologies.slice(0, isFeatured ? 6 : 4).map((technology: string) => <span class="tech-tag">{technology}</span>)}
    </div>
    <footer class="project-card__actions">
      {data.repoUrl && <a href={data.repoUrl} class="project-card__link" target="_blank" rel="noopener noreferrer" aria-label={`View ${data.title} source code on GitHub`}>View source</a>}
      {data.demoUrl && <a href={data.demoUrl} class="project-card__link" target="_blank" rel="noopener noreferrer" aria-label={`View ${data.title} live demo`}>Live demo</a>}
    </footer>
  </div>
</article>