---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data } = project;
const year = data.startDate?.slice(0, 4) ?? '—';
const projectId = `project-${data.title.replace(/\s+/g, '-')}`;

const STATUS_LABELS: Record<'completed' | 'in-progress' | 'archived', string> = {
  completed: 'Completed project',
  'in-progress': 'In progress',
  archived: 'Archived',
};
const metaLabel = featured ? 'Featured project' : STATUS_LABELS[data.status];

const imageSrc = data.image;
const isLocalAsset = imageSrc && imageSrc.startsWith('./');
let imageMetadata: ImageMetadata | null = null;

if (isLocalAsset) {
  const imagePath = imageSrc.replace('./', '');
  if (imagePath === 'Deepfake-Detection.png') {
    const deepfakeImage = await import('../content/projects/images/Deepfake-Detection.png');
    imageMetadata = deepfakeImage.default;
  }
}

const normalizedImageSrc = imageSrc?.startsWith('./') ? imageSrc.replace('./', '/images/') : imageSrc;
const imageSizes = data.imageSizes || '(max-width: 720px) 100vw, 50vw';
---
<article class:list={['project-card', { 'project-card--featured': featured }]} aria-labelledby={projectId}>
  <p class="project-card__meta">
    <span class="project-card__meta-label">{metaLabel}</span>
    <time class="project-card__meta-year" datetime={data.startDate ?? ''}>{year}</time>
  </p>
  {normalizedImageSrc && (
    <div class="project-card__image">
      {isLocalAsset && imageMetadata ? (
        <Image
          src={imageMetadata}
          alt={data.imageAlt || data.title}
          loading="lazy"
          widths={[400, 800, 1200]}
          format="webp"
          quality={80}
          sizes={imageSizes}
        />
      ) : data.imageSrcset ? (
        <img
          src={normalizedImageSrc}
          srcset={data.imageSrcset}
          sizes={imageSizes}
          alt={data.imageAlt || data.title}
          loading="lazy"
          class="img-cover"
          onerror="this.style.display='none'; this.nextElementSibling?.style.display='flex';"
        />
      ) : (
        <img
          src={normalizedImageSrc}
          alt={data.imageAlt || data.title}
          loading="lazy"
          class="img-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
      )}
      <div class="project-card__image-fallback" style="display:none; width:100%; height:100%; align-items:center; justify-content:center; background:var(--card-chip-bg); color:var(--card-fg-secondary); font-family:var(--font-family-mono); font-size:var(--font-size-xs);">
        No preview available
      </div>
    </div>
  )}
  <div class="project-card__content grid-safe">
    <div class="project-card__heading">
      <h3 id={projectId} class="project-card__title">{data.title}</h3>
      {data.subtitle && <h4 class="project-card__subtitle">{data.subtitle}</h4>}
    </div>
    <p class="project-card__description">{data.description || data.problem}</p>
    <ul class="project-card__tech" aria-label="Technologies">
      {data.technologies.slice(0, 6).map((technology: string) => <li class="tech-tag">{technology}</li>)}
    </ul>
    <footer class="project-card__actions">
      {data.repoUrl && <a href={data.repoUrl} class="project-card__link" target="_blank" rel="noopener noreferrer" aria-label={`View ${data.title} source code on GitHub`}>View source code</a>}
      {data.demoUrl && <a href={data.demoUrl} class="project-card__link" target="_blank" rel="noopener noreferrer" aria-label={`View ${data.title} live demo`}>Live demo</a>}
    </footer>
  </div>
</article>
